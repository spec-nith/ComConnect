aws_region                    = "us-east-1"
environment                   = "production"
image_tag                     = "latest"
desired_count                 = 1
service_desired_counts = {
  gateway         = 2
  identity        = 1
  chat            = 2
  message-worker  = 2
  knowledge-indexer = 1
  tasks           = 1
  notifications   = 1
  ai-orchestrator = 1
  ai-engine       = 2
}
service_max_counts = {
  gateway         = 6
  identity        = 3
  chat            = 8
  message-worker  = 8
  knowledge-indexer = 4
  tasks           = 4
  notifications   = 4
  ai-orchestrator = 4
  ai-engine       = 6
}
mongo_uri                     = "mongodb+srv://user:password@cluster.example/comconnect"
kafka_broker                  = "broker.example:9092"
kafka_username                = "replace-me"
kafka_password                = "replace-me"
openai_api_key                = "replace-me"
firebase_service_account_json = "{\"type\":\"service_account\"}"
cors_origin                   = "*"
