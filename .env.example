NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://admin:admin123@mongodb:27017/comconnect?authSource=admin
DB_USERNAME=admin
DB_PASSWORD=admin123
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-an-internal-service-token

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=
REDIS_PASSWORD=
PRESENCE_TTL_SECONDS=75
MESSAGE_STREAM_KEY=chat:messages
MESSAGE_DLQ_STREAM_KEY=chat:messages:dead-letter
MESSAGE_STREAM_CONSUMER_GROUP=message-persistence
MESSAGE_STREAM_MAX_LENGTH=100000
MESSAGE_PERSIST_TIMEOUT_MS=10000
MESSAGE_RESULT_TTL_SECONDS=60
KNOWLEDGE_STREAM_KEY=workspace:knowledge
KNOWLEDGE_DLQ_STREAM_KEY=workspace:knowledge:dead-letter
KNOWLEDGE_STREAM_CONSUMER_GROUP=knowledge-indexing
KNOWLEDGE_STREAM_MAX_LENGTH=200000
KNOWLEDGE_BACKFILL_BATCH_SIZE=200
KNOWLEDGE_BACKFILL_LEASE_MS=600000
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-workers
KAFKA_NOTIFICATION_TOPIC=chat-notifications
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=

AI_SERVICE_URL=http://ai-service:5001
AI_SERVICE_TOKEN=replace-with-an-ai-service-token
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_STORE_BACKEND=chroma
CHROMA_DIR=/data/chroma
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=comconnect-knowledge
OPENSEARCH_VERSION=2.19.1
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
OPENSEARCH_ANALYTICS_ENABLED=true
OPENSEARCH_ANALYTICS_NODE=https://opensearch:9200
OPENSEARCH_ANALYTICS_USERNAME=admin
OPENSEARCH_ANALYTICS_PASSWORD=replace-with-the-opensearch-admin-password
OPENSEARCH_ANALYTICS_INDEX=comconnect-analytics-events
OPENSEARCH_ANALYTICS_SSL_REJECT_UNAUTHORIZED=false
OPENSEARCH_ANALYTICS_TIMEOUT_MS=3000
OPENSEARCH_ANALYTICS_REFRESH=false
RETRIEVAL_LIMIT=8
RETRIEVAL_CANDIDATE_LIMIT=40
RRF_K=60
AI_MODEL_TIMEOUT_SECONDS=60
AI_AGENT_RECURSION_LIMIT=12
WORKSPACE_RAG_MESSAGE_THRESHOLD=200
WORKSPACE_SEARCH_RRF_K=60

NOTIFICATION_SERVICE_URL=http://notification-service:5104
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

REACT_APP_API_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_OPENSEARCH_DASHBOARDS_URL=http://localhost:5601
